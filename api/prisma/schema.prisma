// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// configura "que código eu quero que você gere pra mim"
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// configura "qual banco e como conectar"
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "uso_consumo"]
}

enum OrderStatus {
  PENDENTE
  EM_SEPARACAO
  AGUARDANDO_ENVIO
  ENVIADO
  ENTREGUE

  @@map("order_status")
  @@schema("uso_consumo")
}

enum ItemCategory {
  PAPELARIA
  LIMPEZA

  @@map("item_category")
  @@schema("uso_consumo")
}

/// Tabela do hub central (schema public) — somente leitura, nunca criar/alterar/apagar por aqui.
model Branch {
  id     Int     @id
  name   String
  orders Order[]

  @@map("branchs")
  @@schema("public")
}

/// Tabela do hub central (schema public) — somente leitura, nunca criar/alterar/apagar por aqui.
model User {
  id     Int     @id
  name   String
  orders Order[]

  @@map("users")
  @@schema("public")
}

model Item {
  id         String       @id @default(cuid())
  name       String       @unique
  unit       String
  price      Float        @default(0)
  category   ItemCategory @default(LIMPEZA)
  active     Boolean      @default(true)
  orderItems OrderItem[]

  @@map("item")
  @@schema("uso_consumo")
}

model Order {
  id            String           @id @default(cuid())
  branch        Branch           @relation(fields: [branchId], references: [id])
  branchId      Int              @map("branch_id")
  requestedBy   User             @relation(fields: [requestedById], references: [id])
  requestedById Int              @map("user_hub_id")
  status        OrderStatus      @default(PENDENTE)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deliveredAt   DateTime?        @map("delivered_at")
  items         OrderItem[]
  extraItems    OrderExtraItem[]

  @@map("order")
  @@schema("uso_consumo")
}

model OrderItem {
  id       String @id @default(cuid())
  order    Order  @relation(fields: [orderId], references: [id])
  orderId  String @map("order_id")
  item     Item   @relation(fields: [itemId], references: [id])
  itemId   String @map("item_id")
  quantity Int

  @@map("order_item")
  @@schema("uso_consumo")
}

model OrderExtraItem {
  id       String @id @default(cuid())
  order    Order  @relation(fields: [orderId], references: [id])
  orderId  String @map("order_id")
  name     String
  quantity Int

  @@map("order_extra_item")
  @@schema("uso_consumo")
}
